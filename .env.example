# Firebase Web SDK (Project Settings → General → Your apps → </> Web)
# These are PUBLIC — they ship in the client bundle. Protect with Firestore
# Security Rules (and ideally App Check) instead of trying to hide them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
